# ===== FastAPI 通用后台管理系统 - 环境变量示例 =====
# 使用方法：复制本文件为 .env 并替换占位符值
#   cp .env.example .env
# 安全提示：请勿提交真实密钥到版本库

# JWT 签名密钥（生产环境务必更换为高强度随机字符串）
SECRET_KEY=change_me_to_a_random_secret_key

# JWT 算法
ALGORITHM=HS256

# Access Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库连接字符串（SQLite 默认路径）
DATABASE_URL=sqlite:///./data/app.db

# 初始化管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# 应用名称
APP_NAME=FastAPI Admin System

# CORS 允许的源（逗号分隔，* 表示全部）
CORS_ORIGINS=*
